# Copy to .env (chmod 600) and generate a fresh 64-hex-character token:
#   node scripts/gen-token.mjs
MCP_PORT=8765
MCP_AUTH_TOKEN=replace-with-64-hex-characters-generated-locally

# Optional overrides (defaults shown). Absolute paths; "~" is NOT expanded.
# HERMES_ENV_PATH=$HOME/.hermes/.env              # file that holds API_SERVER_KEY
# HERMES_CONTRACT_PATH=$HOME/.hermes/mcp-bridge-contract.md
# TASKS_DIR=$HOME/bridge-tasks                    # one subdirectory per task id
# AUDIT_LOG=logs/audit.log
# PUBLIC_URL_FILE=PUBLIC_URL
# RATE_LIMIT_PER_MIN=30
# MAX_BODY_BYTES=262144
# MAX_FILE_BYTES=204800
# MAX_RESULT_BYTES=1048576
# MAX_UPSTREAM_BYTES=8388608
# HERMES_TIMEOUT_MS=120000

# Agent registry (optional; default shown)
# AGENTS_FILE=~/.hermes/agents.yaml
# Per-agent API keys are referenced by the registry's key_env (never commit real values)
# HERMES_CODER_API_KEY=replace-with-characters-generated-locally
